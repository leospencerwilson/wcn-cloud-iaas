[Unit]
Description=WCN Cloud provisioner trigger
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/wcn-cloud/provisioner.env
ExecStart=/usr/bin/node /opt/wcn-cloud/provisioner/server.js
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

# Hardening — keep minimal. Service runs as root and needs:
#   - /root/.ssh (key + known_hosts for ssh to Proxmox and customer VMs)
#   - /etc/wcn-cloud (env files)
#   - /var/log/wcn-cloud (job logs)
#   - /tmp (customer.env, cf-cred.json staging)
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
